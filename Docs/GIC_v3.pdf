         <pdf:Keywords>Cortex-A series, Cortex-A15, Cortex-A9, Cortex-A7, Cortex-A12, Cortex-A17, Cortex-A53, Cortex-A57, Cortex-A72, ARMv7, ARMv8, GIC, GIC-500, Interrupt, Controllers</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Arm Generic Interrupt Controller Architecture Specification GIC architecture version 3 and version 4</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ARM Limited</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Arm Generic Interrupt Controller (GIC) Architecture Specification, GICv3 and GICv4. This documentation provides technical information for users who want to design, implement, or program an ARM GIC. It describes GIC interfaces and registers and how to implement the GIC in uniprocessor or multiprocessor systems.</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
